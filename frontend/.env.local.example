# Vorlage fuer die lokale Entwicklung: nach frontend/.env.local kopieren.
# .env.local ist per .gitignore ausgenommen und wird nie deployt.
#
# Der Bypass ueberspringt den Cognito-Login und meldet dich fest als der Demo-Nutzer
# aus backend/seeds/development/01_demo_user.ts an. Er greift ausschliesslich unter
# `npm run dev`; bei `npm run build` wird der Zweig aus dem Bundle entfernt.
#
# Damit das Backend den Dummy-Token akzeptiert, muss es passend dazu laufen:
#
#   docker compose up -d
#   cd backend
#   NODE_ENV=test AUTH_BYPASS=true \
#     DATABASE_URL="postgresql://cloudsheet:dev123@localhost:5432/cloudsheet" \
#     FRONTEND_URL="http://localhost:5173" \
#     npx tsx src/index.ts

VITE_DEV_AUTH_BYPASS=true
VITE_API_URL=http://localhost:8080
